# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# BullMQ / Upstash
# Must be a TCP connection URL, not the Upstash REST URL/token.
UPSTASH_REDIS_URL="rediss://default:password@host:port"

# AI providers (free tiers only). Any provider without a key is skipped.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Optional JSON fallback chain. When unset, the module uses its documented
# default chain. Example:
# AI_FALLBACK_CHAIN='[{"provider":"groq","model":"openai/gpt-oss-120b","rpm":30,"maxTokens":4096}]'
AI_FALLBACK_CHAIN=""
